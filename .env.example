# Non-secret AnyFlo API location. Do not infer this from the web app URL.
ANYFLO_API_BASE_URL=https://api.example.com

# A label for the administrator UI. The key value itself is never returned to browsers.
ANYFLO_API_KEY_NAME=AnyFlo mobile integration

# Server-only; never expose this value through the mobile app, logs, or UI.
ANYFLO_API_KEY=

# Persistent storage location for Hub connection settings.
DATA_DIR=/data

# Bind the service deliberately when deployed.
PORT=3000
