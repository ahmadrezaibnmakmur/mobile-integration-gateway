# Persistent storage for the server-only AnyFlo connection configured in the Hub UI.
# /data is the runtime default and must be a mounted persistent volume.
DATA_DIR=/data

# Bind the service deliberately when deployed.
PORT=3000

# Must equal MOBILE_HUB_WEBHOOK_SECRET in AnyFlo. Generate outside chat.
MOBILE_HUB_WEBHOOK_SECRET=

# App allowlist, with optional provider credentials. Never ship this to a client.
# {"my-app":{"platforms":["android","ios"],"fcm":{"projectId":"...","clientEmail":"...","privateKey":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"},"apns":{"teamId":"...","keyId":"...","privateKey":"...","bundleId":"com.example.app","environment":"sandbox"}}}
PUSH_APPS_JSON={}
